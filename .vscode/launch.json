{
    "version": "0.2.0",
    "configurations": [
        // Configuration for Question-Answering task
        {
            "name": "Question Answering",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "python": "${command:python.interpreterPath}",
            "cwd": "${workspaceFolder}",
            "program": ".venv/bin/question-answering",
            "args": [
                "data=${input:Dataset}",
                "model.pretrained_model_name_or_path=${input:Model}",
                "generation_method=${input:GenerationMethod}",
                "generation_method/confidence_metric=${input:ConfidenceMetric}",
                "output_processor=${input:OutputProcessor}",
                "evaluator=${input:Evaluator}",
                "run_config.seed=${input:Seed}",
            ],
        },
    ],
    "inputs": [
        {
            "id": "Model",
            "type": "pickString",
            "description": "Choose a model",
            "options": [
                "GPT2_137M",
                "GEMMA2_2B_IT",
                "PHI2_3B",
                "DEEPSEEK_R1_DISTILL_QWEN_7B"
            ],
            "default": "GPT2_137M"
        },
        {
            "id": "Dataset",
            "type": "pickString",
            "description": "Choose a dataset",
            "options": [
                "gsm8k",
                "multiarith",
                "argilla_math",
                "commonsense_qa",
                "arc"
            ],
            "default": "gsm8k"
        },
        {
            "id": "GenerationMethod",
            "type": "pickString",
            "description": "Choose a generation method",
            "options": [
                "greedy_decoding",
                "beam_search",
                "cot_decoding",
            ],
            "default": "greedy_decoding"
        },
        {
            "id": "ConfidenceMetric",
            "type": "pickString",
            "description": "Choose a confidence metric",
            "options": [
                "predictive_probability",
                "probability_disparity",
                "entropy",
            ],
            "default": "probability_disparity"
        },
        {
            "id": "OutputProcessor",
            "type": "pickString",
            "description": "Choose an output processor",
            "options": [
                "numeric_answer_with_token_confidence",
                "multiple_choice_answer_with_token_confidence",
                "numeric_answer_with_verbalised_confidence"
            ],
            "default": "numeric_answer_with_token_confidence"
        },
        {
            "id": "Evaluator",
            "type": "pickString",
            "description": "Choose an evaluator",
            "options": [
                "accuracy_and_calibration",
                "accuracy",
                "calibration",
            ],
            "default": "accuracy_and_calibration"
        },
        {
            "id": "Seed",
            "type": "pickString",
            "description": "Choose a random seed",
            "options": [
                "42",
                "1234",
                "5678",
                "9999"
            ],
            "default": "42"
        },
    ]
}